{#
| Variable    | Type   | Description                     |
| article     | object | article.title, article.content, article.featured_image, article.created_at, article.author, ... |
#}
{% extends "layouts.master" %}

{% block title %}{{ article.title is defined and article.title ? article.title : '' }}{% endblock %}

{% block content %}
    {% set article_title = article.title is defined and article.title ? article.title : '' %}
    {% set article_content = article.content is defined and article.content ? article.content : '' %}
    {% set article_date = article.created_at is defined and article.created_at ? article.created_at : null %}

    <article class="dt-post">
        <nav class="dt-breadcrumb" aria-label="{{ trans('common.breadcrumb.aria') }}">
            <a href="{{ link('/') }}" class="dt-breadcrumb__link">{{ trans('common.titles.home') }}</a>
            <span class="dt-breadcrumb__sep" aria-hidden="true">›</span>
            <a href="{{ link('/blog') }}" class="dt-breadcrumb__link">{{ trans('blog.title') }}</a>
            <span class="dt-breadcrumb__sep" aria-hidden="true">›</span>
            <span class="dt-breadcrumb__current">{{ article_title }}</span>
        </nav>

        <header class="dt-post__head">
            {% if article_date %}
                <time class="dt-post__date">{{ article_date|date('j F Y') }}</time>
            {% endif %}
            <h1 class="dt-post__title">{{ article_title }}</h1>
            {% if article.author is defined and article.author %}
                <div class="dt-post__author">{{ trans('blog.author', { author: article.author }) }}</div>
            {% endif %}
        </header>

        {% if article.featured_image is defined and article.featured_image %}
            <div class="dt-post__media">
                <img src="{{ article.featured_image }}" alt="{{ article_title }}" class="dt-post__img">
            </div>
        {% endif %}

        {% if article_content %}
            <div class="dt-post__content">{{ article_content|raw }}</div>
        {% endif %}

        <div class="dt-post__back">
            <a href="{{ link('/blog') }}" class="dt-hero__btn dt-hero__btn--ghost">{{ trans('blog.back') }}</a>
        </div>
    </article>
{% endblock %}