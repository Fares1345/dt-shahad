{#
| Variable      | Type   | Description              |
|---------------|--------|--------------------------|
| page          | object |                          |
| page.title    | string |                          |
| page.slug     | string |                          |
| user          | User   |                          |
| user.first_name, .last_name, .birthday, .gender, .email, .mobile, .avatar | |
| custom_fields | ?Field[] |                        |
#}
{% extends "layouts.customer" %}
{% block inner_content %}
    {% hook 'customer:profile.form.start' %}

    <form class="dt-profile-form" onsubmit="return salla.form.onSubmit('profile.update', event)">
        <div class="dt-profile-form__grid">
            {% hook 'customer:profile.form.fields.start' %}

            <div class="dt-profile-field">
                <label for="first-name" class="dt-profile-field__label">
                    {{ trans('pages.profile.first_name') }}
                </label>
                <input data-testid="store-profile-first-name" type="text" name="first_name" value="{{ user.first_name }}" id="first-name" required
                       autocomplete="first_name" class="dt-profile-field__input">
            </div>

            <div class="dt-profile-field">
                <label for="last-name" class="dt-profile-field__label">
                    {{ trans('pages.profile.last_name') }}
                </label>
                <input data-testid="store-profile-last-name" type="text" name="last_name" value="{{ user.last_name }}" id="last-name" autocomplete="last-name"
                       required class="dt-profile-field__input">
            </div>

            <div class="dt-profile-field">
                <label for="birthday" class="dt-profile-field__label">
                    {{ trans('pages.profile.birthday') }}
                </label>
                <salla-datetime-picker
                        data-testid="store-profile-birthday"
                        dateFormat="Y-m-d"
                        value="{{ user.birthday }}"
                        placeholder="{{ trans('pages.profile.birthday_placeholder') }}"
                        required
                        name="birthday"
                ></salla-datetime-picker>
            </div>

            <div class="dt-profile-field">
                <label for="gender" class="dt-profile-field__label">
                    {{ trans('pages.profile.gender') }}
                </label>
                <select data-testid="store-profile-gender" class="dt-profile-field__input" name="gender" required>
                    <option placeholder value="">{{ trans('pages.profile.gender_placeholder') }}</option>
                    <option value="male" {{ user.gender == 'male' ? 'selected' : '' }}>
                        {{ trans('pages.profile.male') }}
                    </option>
                    <option value="female" {{ user.gender == 'female' ? 'selected' : '' }}>
                        {{ trans('pages.profile.female') }}
                    </option>
                </select>
            </div>

            <div class="dt-profile-field">
                <label for="email" class="dt-profile-field__label">
                    {{ trans('common.elements.email') }}
                </label>
                <input data-testid="store-profile-email" type="email" name="email" value="{{ user.email }}" id="email" class="dt-profile-field__input" required>
            </div>

            <div class="dt-profile-field">
                <label for="international-mobile" class="dt-profile-field__label">
                    {{ trans('common.elements.mobile') }}
                </label>
                <salla-tel-input data-testid="store-profile-phone" phone="{{ user.mobile }}"></salla-tel-input>
            </div>

            {% for field in custom_fields %}
                <div class="dt-profile-field">
                    <label for="{{ field.id }}" class="dt-profile-field__label">
                        {{ field.label }}
                    </label>
                    {% if field.type == 'photo' %}
                        <salla-file-upload
                                instant-upload
                                value="{{ field.value }}"
                                url="{{ store.url|trim('/' ~ user.language_code) }}/upload-image"
                                name="custom_fields[{{ field.id }}]"
                                payload-name="image"
                                height="120px"
                        >
                            <div class="dt-profile-field__upload">
                                <span class="dt-profile-field__upload-icon"><i class="sicon-camera"></i></span>
                                <p class="dt-profile-field__upload-text">{{ trans('common.uploader.drag_and_drop') }}</p>
                                <span class="dt-profile-field__upload-browse">{{ trans('common.uploader.browse') }}</span>
                            </div>
                        </salla-file-upload>
                        <input type="hidden" name="custom_fields[{{ field.id }}]" value="{{ field.value }}">
                    {% else %}
                        <input type="{{ field.type }}"
                               id="{{ field.id }}"
                               value="{{ field.value }}"
                               name="custom_fields[{{ field.id }}]"
                               class="dt-profile-field__input" {{ field.required ? 'required' : '' }}/>
                    {% endif %}
                </div>
            {% endfor %}

            {% hook 'customer:profile.form.fields.end' %}
        </div>

        {% hook 'customer:profile.form.submit.start' %}

        <salla-button data-testid="store-profile-submit" type="submit" loader-position="end" class="dt-profile-form__submit">
            {{ trans('common.elements.save') }}
        </salla-button>

        {% hook 'customer:profile.form.submit.end' %}
    </form>
    {% hook 'customer:profile.form.end' %}

    <salla-verify data-testid="store-profile-verify"></salla-verify>

    <salla-user-settings data-testid="store-profile-settings" {{ user.is_notifiable is defined and user.is_notifiable ? 'is-notifiable' : '' }} class="dt-profile-form__settings"></salla-user-settings>
{% endblock %}