{#
| Variable      | Type                 | Description |
|---------------|----------------------|-------------|
| page          | object               |             |
| page.title    | string               |             |
| page.slug     | string               |             |
| orders[]      | Orders[] *Collection |             |
#}
{% extends "layouts.customer" %}
{% block inner_content %}
    {% if orders is defined and orders|length %}
        {% hook 'customer:orders.index.items.start' %}
        <salla-orders data-testid="store-orders-list"></salla-orders>
        {% hook 'customer:orders.index.items.end' %}
    {% else %}
        <div data-testid="store-orders-empty" class="dt-customer__empty">
            <i class="sicon-packed-box dt-customer__empty-icon" aria-hidden="true"></i>
            <p>{{ trans('pages.orders.non_orders') }}</p>
        </div>
    {% endif %}
{% endblock %}