{#
| Variable    | Type   | Description                                  |
| page        | object | page.title, page.slug, ...                   |
#}
{% extends "layouts.master" %}

{% block content %}
    {% set home_components = theme.components('home') %}
    {% if home_components|length %}
        {% for component in home_components %}
            {% component component.name with {component: component} %}
        {% endfor %}
    {% else %}
        {% component 'home.dt-hero' %}
        {% component 'home.dt-packages' %}
    {% endif %}
{% endblock %}