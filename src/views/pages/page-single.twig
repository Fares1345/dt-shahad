{#
| Variable     | Type   | Description                |
|--------------|--------|----------------------------|
| page         | Page   |                            |
| page.title   | string |                            |
| page.content | string | HTML content of the page   |
| page.url     | string |                            |
| page.slug    | string |                            |
| page.type    | string | normal | customised         |
#}
{% extends "layouts.master" %}

{% block title %}{{ page.title is defined and page.title ? page.title|striptags : '' }}{% endblock %}

{% block content %}
    {% if page.type is defined and page.type == 'customised' %}
        <div class="s-blocks-wrapper s-information-page">{% hook 'information_page.information_page' %}</div>
    {% else %}
        <article class="dt-page">
            <h1 class="dt-page__title">{{ page.title is defined and page.title ? page.title : '' }}</h1>
            {% if page.content is defined and page.content %}
                <div class="dt-page__content">{{ page.content|raw }}</div>
            {% endif %}
            <salla-comments data-testid="store-page-comments" item-id="{{ page.id is defined ? page.id : '' }}" type="page"></salla-comments>
        </article>
    {% endif %}
{% endblock %}