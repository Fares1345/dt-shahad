{#
| Variable    | Type   | Description                      |
| page        | object | page.title, page.content, page.slug, ... |
#}
{% extends "layouts.master" %}

{% block title %}{{ page.title is defined and page.title ? page.title : '' }}{% endblock %}

{% block content %}
    <article class="dt-page">
        <h1 class="dt-page__title">{{ page.title is defined and page.title ? page.title : '' }}</h1>
        {% if page.content is defined and page.content %}
            <div class="dt-page__content">{{ page.content|raw }}</div>
        {% endif %}
    </article>
{% endblock %}