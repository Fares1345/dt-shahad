{#
| Variable   | Type     | Description       |
| title      | string   | عنوان القسم        |
| subtitle   | string   | نص توضيحي          |
| products   | object   | {source, source_value} منتجات الباقات المختارة من إعدادات القالب |
| featured   | object   | الباقة المميزة (الأكثر طلبًا)      |
#}
{% set packages_title = title is defined and title ? title : trans('packages.title') %}
{% set packages_subtitle = subtitle is defined and subtitle ? subtitle : trans('packages.subtitle') %}

{# ── Resolve products source ─────────────────────────────────────────────── #}
{% if products.source is defined and products.source %}
    {% set products_source = products.source %}
    {% set products_ids = products.source_value %}
{% elseif products is iterable %}
    {% set products_source = 'product_ids' %}
    {% set products_ids = products %}
{% else %}
    {% set products_source = '' %}
    {% set products_ids = null %}
{% endif %}

{# ── Resolve featured product id (any field shape: object / array / scalar) ─ #}
{% if featured.source_value is defined and featured.source_value %}
    {% set featured_id = featured.source_value|first %}
{% elseif featured is iterable and featured|length %}
    {% set featured_id = featured|first %}
{% else %}
    {% set featured_id = featured|default('') %}
{% endif %}

<section class="dt-packages" id="packages" data-testid="store-home-dt-packages">
    <div class="dt-packages__inner">
        <div class="dt-packages__head reveal">
            <span class="dt-packages__eyebrow">{{ trans('packages.eyebrow') }}</span>
            <h2 class="dt-packages__title">{{ packages_title }}</h2>
            <p class="dt-packages__subtitle">{{ packages_subtitle }}</p>
        </div>

        {% if products_source and products_ids|length %}
            {# Real store products — fetched and rendered client-side by the Twilight
               web component using our custom card element (app/scripts/packages-card.js). #}
            <salla-products-list
                data-testid="store-home-dt-packages-list"
                source="{{ products_source }}"
                source-value="{{ products_ids|json_encode }}"
                product-card-component="dt-package-card"
                {% if featured_id %}data-featured="{{ featured_id }}"{% endif %}>
            </salla-products-list>
        {% else %}
            {# No package products configured yet — show a neutral configuration
               hint instead of fake products. Merchants pick products in the
               theme editor component settings. #}
            <div class="dt-packages__empty">
                <p class="dt-packages__empty-text">{{ trans('packages.empty') }}</p>
            </div>
        {% endif %}
    </div>
</section>