{#
| Variable   | Type   | Description            |
| badge      | string | المميز (الشارة)        |
| title      | string | العنوان الرئيسي         |
| subtitle   | string | النص التوضيحي          |
| image      | string | صورة الواجهة           |
#}
{% set hero_badge = badge is defined and badge ? badge : trans('hero.badge') %}
{% set hero_title = title is defined and title ? title : trans('hero.title') %}
{% set hero_subtitle = subtitle is defined and subtitle ? subtitle : trans('hero.subtitle') %}
{% set hero_image = image is defined and image ? image : '/assets/images/hero.jpg' %}
{% set title_lines = hero_title|split('\n') %}
{% set title_main = title_lines[0] %}
{% set title_accent = title_lines[1] is defined and title_lines[1] ? title_lines[1] : null %}

<section class="dt-hero hero-grid" data-testid="store-home-dt-hero">
    <div class="dt-hero__content">
        <div class="dt-hero__badge">
            <span class="dt-hero__badge-dot"></span>
            <span class="dt-hero__badge-text">{{ hero_badge }}</span>
        </div>

        <h1 class="dt-hero__title">
            {{ title_main }}
            {% if title_accent %}
                <br><span class="dt-hero__accent">{{ title_accent }}</span>
            {% endif %}
        </h1>

        <p class="dt-hero__subtitle">{{ hero_subtitle }}</p>

        <div class="dt-hero__cta">
            <a class="dt-hero__btn dt-hero__btn--primary" href="{{ link('/') }}#packages">{{ trans('hero.cta.primary') }}</a>
            <a class="dt-hero__btn dt-hero__btn--ghost" href="{{ link('/about') }}">{{ trans('hero.cta.secondary') }}</a>
        </div>

        {% if store.products_count is defined and store.products_count %}
            <div class="dt-hero__stats">
                <div class="dt-hero__stat">
                    <div class="dt-hero__stat-num">{{ store.products_count|number }}</div>
                    <div class="dt-hero__stat-label">{{ trans('hero.stat.products_label') }}</div>
                </div>
            </div>
        {% endif %}
    </div>

    <div class="dt-hero__media">
        <div class="dt-hero__frame">
            {% if hero_image %}
                <img src="{{ hero_image }}" alt="{{ trans('hero.image_alt') }}" class="dt-hero__img">
            {% else %}
                <div class="dt-hero__placeholder">
                    {% include 'partials.logo' with { width: 140 } %}
                </div>
            {% endif %}
        </div>

        <div class="dt-hero__float">
            <div class="dt-hero__float-label">{{ trans('hero.float.label') }}</div>
            <div class="dt-hero__float-title">{{ trans('hero.float.title') }}</div>
            <div class="dt-hero__float-meals">
                <span class="dt-hero__float-meal">{{ trans('hero.float.breakfast') }}</span>
                <span class="dt-hero__float-meal">{{ trans('hero.float.lunch') }}</span>
                <span class="dt-hero__float-meal">{{ trans('hero.float.dinner') }}</span>
            </div>
        </div>

        <div class="dt-hero__logo-mark">
            {% include 'partials.logo' with { variant: 'white', width: 88 } %}
        </div>
    </div>
</section>