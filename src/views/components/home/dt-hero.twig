{#
| Variable   | Type   | Description            |
| badge      | string | المميز (الشارة)        |
| title      | string | العنوان الرئيسي         |
| subtitle   | string | النص التوضيحي          |
| image      | string | صورة الواجهة           |
#}
<section class="dt-hero" data-testid="store-home-dt-hero" style="padding: 4rem 1.5rem; text-align: center;">
    {% if badge is defined and badge %}
        <span style="display: inline-block; padding: .35rem .9rem; border-radius: 999px; background: var(--color-primary); color: var(--color-primary-reverse); font-size: .85rem;">{{ badge }}</span>
    {% endif %}
    {% if title is defined and title %}
        <h2 style="font-size: 2.5rem; margin: 1rem 0 .5rem;">{{ title }}</h2>
    {% endif %}
    {% if subtitle is defined and subtitle %}
        <p style="max-width: 640px; margin: 0 auto;">{{ subtitle }}</p>
    {% endif %}
    {% if image is defined and image %}
        <img src="{{ image }}" alt="{{ title|default('') }}" style="max-width: 100%; margin-top: 2rem; border-radius: 1rem;" />
    {% endif %}
</section>