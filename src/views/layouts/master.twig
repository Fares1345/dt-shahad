<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}{{ store.name }}{% endblock %}</title>

    {% block head_scripts %}{% endblock %}

    {% hook 'head:start' %}
    {% hook head %}

    {% block styles %}{% endblock %}

    <link rel="stylesheet" href="{{ 'app.css' | asset }}">

    {% if theme.font %}
        <link rel="stylesheet" href="{{ theme.font.path | cdn }}">
    {% endif %}

    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css' | cdn }}">

    <style>
        :root {
            --font-main: '{{ theme.font.name ?? "Arial" }}';

            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: var(--font-main), 'Segoe UI', Tahoma, sans-serif;
        }

        main {
            min-height: 70vh;
        }
    </style>

    {% hook 'head:end' %}
</head>

<body id="app" class="dt-shahad {% hook 'body:classes' %}">

    <noscript>
        {{ trans('noscript.text') }}
        <a
            href="https://www.enable-javascript.com/"
            rel="noreferrer"
            target="_blank"
        >
            {{ trans('noscript.link') }}
        </a>
    </noscript>

    <div class="dt-loader" id="dt-loader" aria-hidden="true">
        <div class="dt-loader__inner">
            <span class="dt-loader__spinner"></span>
            <span class="dt-loader__text">
                {{ trans('brand.loading') }}
            </span>
        </div>
    </div>

    <div class="app-inner">

        {% hook 'body:start' %}

        {% component 'header.header' %}

        <main id="main-content" role="main">
            {% block content %}{% endblock %}
        </main>

        {% component 'footer.footer' %}

    </div>

    {% hook 'body:end' %}

    <salla-offer-modal></salla-offer-modal>
    <salla-search></salla-search>
    <salla-login-modal></salla-login-modal>

    <script
        defer
        crossorigin="anonymous"
        src="{{ 'app.js' | asset }}"
    ></script>

    <script
        defer
        data-cfasync="false"
        src="{{ 'assets/packages-card.js' | asset }}"
    ></script>

    <script data-cfasync="false">
        (function () {
            var loader = document.getElementById('dt-loader');

            if (!loader) {
                return;
            }

            function hideLoader() {
                loader.classList.add('dt-loader--hidden');

                setTimeout(function () {
                    loader.style.display = 'none';
                }, 700);
            }

            if (document.readyState === 'complete') {
                hideLoader();
            } else {
                window.addEventListener('load', hideLoader);
            }

            setTimeout(hideLoader, 4000);
        })();
    </script>

