<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ store.name }}{% endblock %}</title>

    {% block head_scripts %}{% endblock %}

    <script defer data-cfasync="false" src="{{ 'assets/packages-card.js' | asset }}"></script>

    {% hook 'head:start' %}
    {% hook head %}
    {% block styles %}
        <link rel="stylesheet" href="{{ 'app.css' | asset }}">
        <link rel="stylesheet" href="{{ 'fonts/sallaicons.css'|cdn }}">
    {% endblock %}

    <style>
        :root {
            --color-primary: {{ theme.color.primary }};
            --color-primary-dark: {{ theme.color.darker(0.15) }};
            --color-primary-light: {{ theme.color.lighter(0.15) }};
            --color-primary-reverse: {{ theme.color.reverse_text }};
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: 'Segoe UI', Tahoma, sans-serif; }
        main { min-height: 70vh; }
    </style>

    {# tracking services, custom css feature. #}
    {% hook 'head:end' %}
</head>
<body id="app" class="dt-shahad {% hook 'body:classes' %}">
    <noscript>
        {{ trans('noscript.text') }}
        <a href="https://www.enable-javascript.com/" rel="noreferrer" target="_blank">{{ trans('noscript.link') }}</a>.
    </noscript>

    <div class="dt-loader" id="dt-loader" aria-hidden="true">
        <div class="dt-loader__inner">
            <span class="dt-loader__spinner"></span>
            <span class="dt-loader__text">{{ trans('brand.loading') }}</span>
        </div>
    </div>

    <script data-cfasync="false">
        (function () {
            var loader = document.getElementById('dt-loader');
            if (!loader) return;
            function hide() {
                loader.classList.add('dt-loader--hidden');
                setTimeout(function () { loader.style.display = 'none'; }, 700);
            }
            if (document.readyState === 'complete') {
                hide();
            } else {
                window.addEventListener('load', hide);
            }
            setTimeout(hide, 4000);
        })();
    </script>

    <div class="app-inner">
        {% hook 'body:start' %}
        {% include 'partials.header' %}
        <main id="main-content" role="main">
            {% block content %}{% endblock %}
        </main>
        {% include 'partials.footer' %}
        {% hook 'body:end' %}
    </div>

    {# Twilight Global Components - required for storefront functionality #}
    <salla-offer-modal data-testid="store-offer-modal"></salla-offer-modal>
    <salla-search data-testid="store-search-modal"></salla-search>
    <salla-login-modal data-testid="store-login-modal"></salla-login-modal>
    {% if store.scope %}
        <salla-scopes data-testid="store-scopes" selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"></salla-scopes>
    {% endif %}

    {% block scripts %}{% endblock %}
</body>
</html>