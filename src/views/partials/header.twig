{# DT. SHAHAD Header — static port of app/components/layout/DtSiteHeader.tsx #}
<header class="dt-header" data-testid="store-header">
    <div class="dt-header__inner">
        <a href="{{ link('/') }}" class="dt-logo-link" aria-label="{{ trans('common.titles.home') }}">
            {% include 'partials.logo' with { width: 96 } %}
        </a>

        <nav class="dt-nav" aria-label="{{ trans('header.nav.label') }}">
            {# Salla-managed header menu - styled to match DT design #}
            <salla-menu data-testid="store-header-menu" source="header" class="dt-salla-menu"></salla-menu>
        </nav>

        <div class="dt-header__actions">
            <a href="{{ link('/search') }}" class="dt-icon-btn" aria-label="{{ trans('header.aria.search') }}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.3-4.3"></path>
                </svg>
            </a>
            <a href="{{ link('/cart') }}" class="dt-icon-btn" aria-label="{{ trans('header.aria.cart') }}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="8" cy="21" r="1"></circle>
                    <circle cx="19" cy="21" r="1"></circle>
                    <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
                </svg>
                <span class="dt-cart-badge" id="dt-cart-badge"{% if cart.items_count == 0 %} style="display: none;"{% endif %}>
                    <span id="dt-cart-count">{{ cart.items_count }}</span>
                </span>
            </a>
            <a href="{{ link('/customer/profile') }}" class="dt-icon-btn" aria-label="{{ trans('header.aria.account') }}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </a>
            <button type="button" id="dt-menu-toggle" class="dt-menu-btn" aria-expanded="false"
                        aria-controls="dt-mobile-menu" aria-label="{{ trans('header.aria.open_menu') }}"
                        data-label-close="{{ trans('header.aria.close_menu') }}">
                <svg class="dt-menu-icon dt-menu-icon--burger" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path>
                </svg>
                <svg class="dt-menu-icon dt-menu-icon--close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
                </svg>
            </button>
        </div>
    </div>

    {# Mobile menu with Salla-managed header menu #}
    <div class="dt-mobile-menu" id="dt-mobile-menu">
        <nav aria-label="{{ trans('header.mobile.label') }}">
            <salla-menu data-testid="store-header-mobile-menu" source="header"></salla-menu>
        </nav>
    </div>

    {# Salla contacts in header (admin-managed) #}
    <div class="dt-header-contacts d-none d-lg-flex">
        <salla-contacts data-testid="store-header-contacts" is-header class="dt-salla-contacts"></salla-contacts>
    </div>
</header>

<script data-cfasync="false">
    (function () {
        var inited = false;
        function init() {
            if (inited) return;
            inited = true;
            var salla = window.salla;
            if (!salla) return;
            var badge = document.getElementById('dt-cart-badge');
            var countEl = document.getElementById('dt-cart-count');
            if (!badge || !countEl) return;

            function refresh() {
                var summary = salla.storage && typeof salla.storage.get === 'function'
                    ? salla.storage.get('cart.summary')
                    : null;
                var count = summary && typeof summary.count === 'number' ? summary.count : 0;
                countEl.textContent = count;
                badge.style.display = count > 0 ? 'flex' : 'none';
            }

            var cartEvents = salla.cart && salla.cart.event
                ? salla.cart.event
                : (salla.event && salla.event.cart) || null;
            ['onItemAdded', 'onItemDeleted', 'onItemUpdated', 'onUpdated', 'onLatestFetched'].forEach(function (name) {
                if (cartEvents && typeof cartEvents[name] === 'function') {
                    cartEvents[name](refresh);
                }
            });

            refresh();
        }

        if (document.readyState !== 'loading') {
            init();
        } else {
            document.addEventListener('DOMContentLoaded', init);
        }
        if (window.salla && typeof salla.onReady === 'function') {
            salla.onReady(init);
        } else {
            document.addEventListener('theme::ready', init, { once: true });
        }
    })();

    (function () {
        var btn = document.getElementById('dt-menu-toggle');
        var menu = document.getElementById('dt-mobile-menu');
        if (!btn || !menu) return;

        function setOpen(open) {
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            btn.setAttribute('aria-label', open ? btn.getAttribute('data-label-close') : btn.getAttribute('data-label-open'));
            menu.classList.toggle('dt-mobile-menu--open', open);
        }

        btn.setAttribute('data-label-open', btn.getAttribute('aria-label'));
        btn.addEventListener('click', function () {
            setOpen(btn.getAttribute('aria-expanded') !== 'true');
        });
        menu.addEventListener('click', function (event) {
            if (event.target.closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
                setOpen(false);
                btn.focus();
            }
        });
    })();
</script>

<style>
    .dt-salla-contacts { display: contents; }
    .dt-header-contacts { margin-right: 16px; }

    /* Style salla-menu to match DT. SHAHAD nav design */
    .dt-salla-menu { display: contents; }
    .dt-salla-menu a {
        font-family: 'Cairo', sans-serif;
        font-size: 14px;
        font-weight: 500;
        color: #7A7869;
        text-decoration: none;
        padding: 8px 14px;
        border-radius: 2px;
        transition: color 0.2s ease;
    }
    .dt-salla-menu a:hover,
    .dt-salla-menu a.is-active,
    .dt-salla-menu a[aria-current="page"] {
        color: #1C1B18;
    }
    .dt-salla-menu > :not(a) { display: none; }
</style>