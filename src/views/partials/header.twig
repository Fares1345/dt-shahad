{# DT. SHAHAD Header — static port of app/components/layout/DtSiteHeader.tsx #}
<header class="dt-header" data-testid="store-header">
    <input type="checkbox" id="dt-menu-toggle" class="dt-menu-toggle" aria-hidden="true">

    <div class="dt-header__inner">
        <a href="{{ link('/') }}" class="dt-logo-link" aria-label="الرئيسية">
            {% include 'partials.logo' with { width: 96 } %}
        </a>

        <nav class="dt-nav" aria-label="التنقل الرئيسي">
            <a href="{{ link('/') }}" class="dt-nav__link{{ is_page('index') ? ' is-active' : '' }}">الرئيسية</a>
            <a href="{{ link('/') }}#packages" class="dt-nav__link">الباقات</a>
            <a href="{{ link('/about') }}" class="dt-nav__link{{ is_page('page', 'about') ? ' is-active' : '' }}">من نحن</a>
            <a href="{{ link('/blog') }}" class="dt-nav__link{{ is_page('blog') ? ' is-active' : '' }}">المدونة</a>
        </nav>

        <div class="dt-header__actions">
            <a href="{{ link('/search') }}" class="dt-icon-btn" aria-label="بحث">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.3-4.3"></path>
                </svg>
            </a>
            <a href="{{ link('/cart') }}" class="dt-icon-btn" aria-label="سلة التسوق">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="8" cy="21" r="1"></circle>
                    <circle cx="19" cy="21" r="1"></circle>
                    <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
                </svg>
                <span class="dt-cart-badge" id="dt-cart-badge"{% if cart.items_count == 0 %} style="display: none;"{% endif %}>
                    <span id="dt-cart-count">{{ cart.items_count }}</span>
                </span>
            </a>
            <a href="{{ link('/customer/profile') }}" class="dt-icon-btn" aria-label="الحساب">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </a>
            <label for="dt-menu-toggle" class="dt-menu-btn" role="button" aria-label="فتح القائمة">
                <svg class="dt-menu-icon dt-menu-icon--burger" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path>
                </svg>
                <svg class="dt-menu-icon dt-menu-icon--close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
                </svg>
            </label>
        </div>
    </div>

    <div class="dt-mobile-menu">
        <nav aria-label="القائمة">
            <a href="{{ link('/') }}" class="dt-mobile-menu__link">الرئيسية</a>
            <a href="{{ link('/') }}#packages" class="dt-mobile-menu__link">الباقات</a>
            <a href="{{ link('/about') }}" class="dt-mobile-menu__link">من نحن</a>
            <a href="{{ link('/blog') }}" class="dt-mobile-menu__link">المدونة</a>
        </nav>
    </div>
</header>

<script data-cfasync="false">
    (function () {
        var inited = false;
        function init() {
            if (inited) return;
            inited = true;
            var salla = window.salla;
            if (!salla) return;
            var badge = document.getElementById('dt-cart-badge');
            var countEl = document.getElementById('dt-cart-count');
            if (!badge || !countEl) return;

            function refresh() {
                var summary = salla.storage && typeof salla.storage.get === 'function'
                    ? salla.storage.get('cart.summary')
                    : null;
                var count = summary && typeof summary.count === 'number' ? summary.count : 0;
                countEl.textContent = count;
                badge.style.display = count > 0 ? 'flex' : 'none';
            }

            var cartEvents = salla.cart && salla.cart.event
                ? salla.cart.event
                : (salla.event && salla.event.cart) || null;
            ['onItemAdded', 'onItemDeleted', 'onItemUpdated', 'onUpdated', 'onLatestFetched'].forEach(function (name) {
                if (cartEvents && typeof cartEvents[name] === 'function') {
                    cartEvents[name](refresh);
                }
            });

            refresh();
        }

        if (document.readyState !== 'loading') {
            init();
        } else {
            document.addEventListener('DOMContentLoaded', init);
        }
        if (window.salla && typeof salla.onReady === 'function') {
            salla.onReady(init);
        } else {
            document.addEventListener('theme::ready', init, { once: true });
        }
    })();
</script>