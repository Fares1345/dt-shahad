{# DT. SHAHAD Footer — static port of app/components/layout/DtSiteFooter.tsx #}
<footer class="dt-footer" data-testid="store-footer">
    <div class="dt-footer__inner">
        <div class="dt-footer__grid">
            <div class="dt-footer__brand">
                <div class="dt-footer__logo">
                    {% include 'partials.logo' with { variant: 'white', width: 160 } %}
                </div>
                <p class="dt-footer__tagline">{{ trans('footer.tagline') }}</p>

                {# Salla-managed social links (uses store.social data) #}
                <salla-social data-testid="store-footer-social" class="dt-salla-social d-none d-lg-flex"></salla-social>
            </div>

            <div class="dt-footer__nav">
                <h4 class="dt-footer__heading">{{ trans('footer.nav.heading') }}</h4>
                {# Salla-managed footer menu (admin-configured links) #}
                <salla-menu data-testid="store-footer-menu" source="footer" class="dt-salla-menu" with-cookie-preferences></salla-menu>
            </div>

            <div class="dt-footer__contact">
                <h4 class="dt-footer__heading">{{ trans('footer.contact.heading') }}</h4>
                {# Salla-managed contacts (uses store.contacts data) #}
                <salla-contacts data-testid="store-footer-contacts" class="dt-salla-contacts"></salla-contacts>

                {# Mobile social links (hidden on desktop) #}
                <div class="lg:hidden contact-social">
                    <salla-social data-testid="store-footer-social-mobile"></salla-social>
                </div>
            </div>
        </div>

        <div class="dt-footer__divider"></div>

        <div class="dt-footer__bottom">
            <p class="dt-footer__copyright">{% hook copyright %}{{ trans('footer.copyright') }}</p>
            <p class="dt-footer__powered">{{ trans('footer.powered') }}</p>
            {# Salla-managed trust badges, app icons, and payment methods #}
            <div class="dt-footer__badges">
                <salla-trust-badges data-testid="store-footer-trust-badges"></salla-trust-badges>
                <salla-apps-icons data-testid="store-footer-apps"></salla-apps-icons>
                <salla-payments data-testid="store-footer-payments"></salla-payments>
            </div>
        </div>
    </div>

    {# VAT Certificate Modal (KSA legal requirement) - matches Theme Raed pattern #}
    {% if store.settings.tax.number %}
        <div class="flex rtl:space-x-reverse space-x-2 items-end mb-4">
            {% if store.settings.tax.certificate %}
                <a class="load-img-onclick" data-modal-id="modal-value-tax" href="#/" alt="{{ store.settings.tax.number }}">
                    <img width="40" height="50" src="{{'images/tax.png' | cdn(70,70)}}" loading="lazy" class="w-10 rounded-sm hover:opacity-80 transition-opacity" alt="value added tax">
                </a>
            {% endif %}
            <div>
                <p class="text-sm text-text-grey mb-1">{{ trans('common.elements.tax_number') }}</p>
                <b class="text-sm">{{ store.settings.tax.number }}</b>
            </div>
        </div>
        {% if store.settings.tax.certificate %}
            <salla-modal data-testid="store-footer-tax-modal"
                         sub-title-first
                         sub-title="{{ trans('common.elements.tax_number') }}"
                         modal-title="{{ store.settings.tax.number }}"
                         id="modal-value-tax">
                <div class="flex justify-center max-w-full">
                    <img class="w-full" loading="lazy"
                         data-src="{{ store.settings.tax.certificate }}"
                         alt="{{ store.settings.tax.number }}"/>
                </div>
            </salla-modal>
        {% endif %}
    {% endif %}
</footer>

<style>
    .dt-salla-menu { display: contents; }
    .dt-salla-social { display: contents; }
    .dt-salla-contacts { display: contents; }
    .dt-footer__badges { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 16px; }
</style>