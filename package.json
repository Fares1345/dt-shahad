{
  "name": "dt-shahad",
  "version": "1.0.0",
  "description": "dt-shahad - a Salla React theme",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node -e \"require('fs').rmSync('public/assets/app.js',{force:true})\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@salla.sa/twilight-components-react": "^3.0.0-beta.1",
    "@salla.sa/twilight-theme-engine": "^1.0.0",
    "@tanstack/react-query": "~5.101.4",
    "@tanstack/react-router": "~1.170.21",
    "@tanstack/react-router-devtools": "~1.167.1",
    "@tanstack/react-start": "~1.168.38",
    "@tanstack/virtual-file-routes": "~1.162.0",
    "@uidotdev/usehooks": "^2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@salla.sa/twilight-tailwind-theme": "^3.0.0-beta.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tanstack/router-plugin": "~1.168.26",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "~6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "esbuild": "0.28.1",
    "jsdom": "^30.0.1",
    "postcss": "8.5.26",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.102.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "@tanstack/react-query-devtools": "~5.101.4"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
